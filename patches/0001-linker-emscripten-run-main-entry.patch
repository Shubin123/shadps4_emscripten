diff --git a/src/core/linker.cpp b/src/core/linker.cpp
index 44d216d..2a79633 100644
--- a/src/core/linker.cpp
+++ b/src/core/linker.cpp
@@ -32,6 +32,12 @@
 #include <signal.h>
 #endif
 
+#if defined(__EMSCRIPTEN__)
+#include "core/interpreter/guest_address_space.h"
+#include "core/interpreter/host_thunk.h"
+#include "core/interpreter/x86_interpreter.h"
+#endif
+
 namespace Core {
 
 static PS4_SYSV_ABI void ProgramExitFunc() {
@@ -59,6 +65,49 @@ static PS4_SYSV_ABI void* RunMainEntry [[noreturn]](EntryParams* params) {
                  : "r"(params->entry_addr), "r"(params), "r"(ProgramExitFunc)
                  : "rax", "rsi", "rdi");
     UNREACHABLE();
+#elif defined(__EMSCRIPTEN__)
+    // Every other target above runs the guest's x86-64 machine code directly on the host CPU -
+    // not possible for WebAssembly, which can't be handed arbitrary machine code to execute.
+    // Core::Interpreter::X86Interpreter (src/core/interpreter/) interprets it instead. See
+    // PROJECT.md in the shadps4_emscripten repo ("Why this is a different kind of port") for the
+    // full picture; in short, this compiles and documents the intended connection point but does
+    // not run anything useful yet, for two concrete, separate reasons:
+    //
+    //  1. `memory` below is a throwaway Core::Interpreter::GuestAddressSpace, not the real,
+    //     ported Core::Memory/AddressSpace - that class's Map() still does a host mmap() call at
+    //     a fixed 40-bit-wide reservation, which has no WebAssembly equivalent and hasn't been
+    //     adapted yet. Nothing here has copied the loaded module's segments into `memory`
+    //     either, so the interpreter will hit "fetch from unmapped address" immediately at
+    //     runtime - expected until that porting work lands, not a bug in this branch.
+    //  2. The surrounding CMake/Emscripten build integration needed to get this file (and
+    //     everything it transitively includes) to compile with emcmake hasn't been done -
+    //     starting with CMakeLists.txt's architecture detection, which currently hard-fails with
+    //     "Unsupported CPU architecture" for wasm32/wasm64 before reaching any target-specific
+    //     code at all.
+    //
+    // What this branch does fix, rather than defer: the original asm above hands guest code a
+    // *host* pointer in rdi (`params`, e.g. the global Libraries::Kernel::entry_params) and
+    // expects it to be dereferenceable as a guest address - true only because direct execution
+    // shares one address space between guest and host. That would silently break once guest and
+    // host addresses are no longer the same numbers, so EntryParams is copied into translated
+    // guest memory here instead of pointing at the host original.
+    static Core::Interpreter::GuestAddressSpace memory; // TODO: replace with the real, ported
+                                                          // Core::Memory/AddressSpace (point 1
+                                                          // above).
+    static Core::Interpreter::HostThunkTable thunks;
+    static Core::Interpreter::X86Interpreter cpu(memory, thunks);
+
+    const VAddr params_addr = memory.MapAnywhere(sizeof(EntryParams));
+    memory.WriteBytes(params_addr, params, sizeof(EntryParams));
+    // argv[] still holds raw host `const char*` pointers (copied byte-for-byte above) - those
+    // need the same guest-memory treatment if/when guest code actually dereferences them. Not
+    // done here; flagging it precisely rather than leaving it an implicit trap for later.
+
+    const std::uint64_t exit_addr = thunks.Register([](Core::Interpreter::X86Interpreter&) {
+        LOG_ERROR(Core_Linker, "Exit function called");
+        UNREACHABLE();
+    });
+    cpu.RunMainEntry(params->entry_addr, params_addr, exit_addr);
 #else
     UNREACHABLE_MSG("RunMainEntry unimplemented for current architecture.");
 #endif
